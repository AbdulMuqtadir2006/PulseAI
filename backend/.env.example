# Postgres connection string. On Railway, add a Postgres plugin to the
# project and reference its DATABASE_URL — no local setup needed there.
# For local dev, point at a local/dockerized Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulseguard

# OpenRouter (optional) — powers the plain-language risk narrative.
# Leave unset and the app falls back to a deterministic explanation instead
# of silently failing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1

# Emergency notification provider (optional). Leave unset and alerts are
# simulated: logged + stored as an AlertEvent, never actually sent. This is
# intentional — never wire a real provider without deliberately deciding to.
EMERGENCY_WEBHOOK_URL=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

PORT=8000
